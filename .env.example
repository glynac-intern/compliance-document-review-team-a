# --- Database ---
POSTGRES_USER=compliance_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=compliance_db
# DATABASE_URL is intentionally not set here (TA-81): docker-compose.yml
# builds it for the backend service from the three POSTGRES_* vars above,
# so it can never disagree with the password you actually set. If you run
# the backend outside Docker, set DATABASE_URL yourself, matching
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB above:
#   postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/<POSTGRES_DB>

# --- LLM (Gemini via Google AI Studio) ---
LLM_PROVIDER=gemini
LLM_API_KEY=your_google_ai_studio_key_here

# --- Model configuration (single source of truth, see TA-42) ---
# Embedding model + dimension used for rule retrieval and disclosure
# detection. Must match what the DB's pgvector columns expect -- changing
# EMBEDDING_DIM requires a new migration to alter the vector column size.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Model used for both flag generation and summarization.
GENERATION_MODEL=gemini-3.5-flash-lite

# Sampling temperature per generation task -- flagging stays low/deterministic
# (compliance judgments shouldn't vary run to run), summarization allows a
# bit more natural phrasing.
FLAG_GENERATION_TEMPERATURE=0.1
SUMMARY_GENERATION_TEMPERATURE=0.2

# --- Backend ---
BACKEND_SECRET_KEY=changeme_generate_a_real_secret
BACKEND_PORT=8000

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
