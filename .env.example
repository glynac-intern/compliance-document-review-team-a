# --- Database ---
POSTGRES_USER=compliance_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=compliance_db
# DATABASE_URL is intentionally not set here (TA-81): docker-compose.yml
# builds it for the backend service from the three POSTGRES_* vars above,
# so it can never disagree with the password you actually set. If you run
# the backend outside Docker, set DATABASE_URL yourself, matching
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB above:
#   postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/<POSTGRES_DB>

# --- LLM (Gemini via Google AI Studio) ---
LLM_PROVIDER=gemini
LLM_API_KEY=your_google_ai_studio_key_here

# --- Model configuration (single source of truth, see TA-42) ---
# Embedding model + dimension used for rule retrieval and disclosure
# detection. Must match what the DB's pgvector columns expect -- changing
# EMBEDDING_DIM requires a new migration to alter the vector column size.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Model used for both flag generation and summarization.
GENERATION_MODEL=gemini-3.5-flash-lite

# Sampling temperature per generation task -- flagging stays low/deterministic
# (compliance judgments shouldn't vary run to run), summarization allows a
# bit more natural phrasing, and chat allows the most since it's answering
# open-ended officer questions rather than making a judgment call.
FLAG_GENERATION_TEMPERATURE=0.1
SUMMARY_GENERATION_TEMPERATURE=0.2
CHAT_GENERATION_TEMPERATURE=0.3

# --- Backend ---
BACKEND_SECRET_KEY=changeme_generate_a_real_secret
BACKEND_PORT=8000

# --- Frontend ---
# Read at `docker compose build` time (passed as a build arg -- see
# docker-compose.yml), not at container start: the frontend runs a real
# production build (`next build` + `next start`), and NEXT_PUBLIC_* vars
# get inlined into the JS bundle at build time. Changing this value on a
# running deployment requires rebuilding the frontend image, not just
# restarting the container.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Deployment (optional; leave unset for local dev) ---
# TA-89: must be a real HOSTNAME, not a bare IP -- Caddy (see Caddyfile)
# uses this to request a real Let's Encrypt certificate automatically,
# and Let's Encrypt cannot issue a certificate for a bare IP address.
# If you don't have a domain, sslip.io gives you one for free with zero
# setup: it maps <ip-with-dashes>.sslip.io to that IP automatically, so
# e.g. an Azure VM at 104.211.102.169 can use 104-211-102-169.sslip.io
# as a real, working hostname today, with no DNS configuration at all.
#
# Also feeds the backend's CORS allow-list (backend/main.py) so the
# frontend's origin, served through Caddy, is permitted. Previously
# handled by hand-editing backend/main.py and frontend/next.config.ts
# directly on the deploy target, uncommitted -- fragile, since nothing
# else in the repo ever set it and a stray git checkout/reset there
# would silently wipe it.
# PUBLIC_HOST=104-211-102-169.sslip.io
#
# When PUBLIC_HOST is set, also point the frontend at the backend
# through Caddy's api. subdomain instead of localhost -- see Caddyfile:
# NEXT_PUBLIC_API_BASE_URL=https://api.104-211-102-169.sslip.io
#
# IMPORTANT: once Caddy is running, close ports 3000 and 8000 to the
# public internet at the firewall/NSG level (Azure: Network Security
# Group inbound rules) -- only 80/443 (and 22 for SSH) should be
# reachable from outside. docker-compose.yml still publishes 3000/8000
# for local-dev convenience; that's a host-level bind, not a substitute
# for a network-level firewall rule on a real deployment.
